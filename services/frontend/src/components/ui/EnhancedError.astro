---
/**
 * EnhancedError - Rich error display with icons, hints, and actions
 * 
 * Usage:
 * <EnhancedError id="myError" />
 * 
 * Then in JS:
 * import { showEnhancedError, hideEnhancedError } from "./EnhancedError";
 * showEnhancedError("myError", error, { onRetry: () => {} });
 */

const {
  id,
  class: className = "",
} = Astro.props as {
  id: string;
  class?: string;
};
---

<div id={id} class={`enhanced-error ${className}`.trim()} style="display: none;" role="alert">
  <div class="enhanced-error-container">
    <div class="enhanced-error-icon" data-icon></div>
    <div class="enhanced-error-content">
      <h3 class="enhanced-error-title" data-title>Error</h3>
      <p class="enhanced-error-message" data-message></p>
      <p class="enhanced-error-hint" data-hint></p>
    </div>
    <div class="enhanced-error-actions" data-actions></div>
  </div>
</div>

<style>
  .enhanced-error {
    animation: errorSlideIn 0.3s ease-out;
  }

  .enhanced-error-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: var(--space-5);
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    border-left: 4px solid var(--color-bad);
  }

  .enhanced-error-icon {
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-4);
    border-radius: 50%;
    background: rgba(var(--color-bad-rgb, 239, 68, 68), 0.1);
    color: var(--color-bad);
  }

  .enhanced-error-icon :global(svg) {
    width: 28px;
    height: 28px;
  }

  .enhanced-error-content {
    max-width: 400px;
  }

  .enhanced-error-title {
    margin: 0 0 var(--space-2);
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--text-1);
  }

  .enhanced-error-message {
    margin: 0 0 var(--space-2);
    font-size: var(--text-md);
    color: var(--text-2);
    line-height: 1.5;
  }

  .enhanced-error-hint {
    margin: 0;
    padding: var(--space-3);
    font-size: var(--text-sm);
    color: var(--text-3);
    background: var(--surface-2);
    border-radius: var(--radius-md);
    line-height: 1.5;
  }

  .enhanced-error-hint:empty {
    display: none;
  }

  .enhanced-error-actions {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .enhanced-error-actions:empty {
    display: none;
  }

  /* Action buttons */
  .enhanced-error :global(.error-action-btn) {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-sm);
    font-weight: 500;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .enhanced-error :global(.error-action-primary) {
    background: var(--color-accent-1);
    color: white;
    border: none;
  }

  .enhanced-error :global(.error-action-primary:hover) {
    background: var(--color-accent-2);
  }

  .enhanced-error :global(.error-action-secondary) {
    background: transparent;
    color: var(--text-2);
    border: 1px solid var(--border);
  }

  .enhanced-error :global(.error-action-secondary:hover) {
    background: var(--surface-1);
    color: var(--text-1);
  }

  /* Variants by error type */
  .enhanced-error[data-type="auth"] .enhanced-error-container,
  .enhanced-error[data-type="forbidden"] .enhanced-error-container {
    border-left-color: var(--color-warn);
  }

  .enhanced-error[data-type="auth"] .enhanced-error-icon,
  .enhanced-error[data-type="forbidden"] .enhanced-error-icon {
    background: rgba(var(--color-warn-rgb, 245, 158, 11), 0.1);
    color: var(--color-warn);
  }

  .enhanced-error[data-type="network"] .enhanced-error-container,
  .enhanced-error[data-type="timeout"] .enhanced-error-container {
    border-left-color: var(--text-3);
  }

  .enhanced-error[data-type="network"] .enhanced-error-icon,
  .enhanced-error[data-type="timeout"] .enhanced-error-icon {
    background: var(--surface-2);
    color: var(--text-2);
  }

  @keyframes errorSlideIn {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Compact variant */
  .enhanced-error.compact .enhanced-error-container {
    flex-direction: row;
    text-align: left;
    padding: var(--space-3) var(--space-4);
    gap: var(--space-3);
  }

  .enhanced-error.compact .enhanced-error-icon {
    width: 40px;
    height: 40px;
    margin-bottom: 0;
    flex-shrink: 0;
  }

  .enhanced-error.compact .enhanced-error-icon :global(svg) {
    width: 20px;
    height: 20px;
  }

  .enhanced-error.compact .enhanced-error-content {
    flex: 1;
    min-width: 0;
  }

  .enhanced-error.compact .enhanced-error-title {
    font-size: var(--text-md);
  }

  .enhanced-error.compact .enhanced-error-message {
    font-size: var(--text-sm);
  }

  .enhanced-error.compact .enhanced-error-hint {
    padding: var(--space-2);
    margin-top: var(--space-2);
  }

  .enhanced-error.compact .enhanced-error-actions {
    margin-top: var(--space-2);
    margin-left: 0;
  }

  @media (max-width: 560px) {
    .enhanced-error.compact .enhanced-error-container {
      flex-direction: column;
      text-align: center;
    }

    .enhanced-error.compact .enhanced-error-icon {
      margin-bottom: var(--space-3);
    }
  }
</style>

<script>
  // This script provides the API for showing/hiding enhanced errors
  import { getErrorInfo, ERROR_ICONS, type ErrorInfo } from "../../lib/errors";

  type ErrorOptions = {
    onRetry?: () => void;
    onRefresh?: () => void;
    onSettings?: () => void;
    onUpgrade?: () => void;
    compact?: boolean;
  };

  // Store callbacks per error element
  const callbacks = new Map<string, ErrorOptions>();

  /**
   * Show an enhanced error message
   */
  export function showEnhancedError(
    elementId: string, 
    error: unknown, 
    options: ErrorOptions = {}
  ): void {
    const container = document.getElementById(elementId);
    if (!container) return;

    const info = getErrorInfo(error);
    callbacks.set(elementId, options);

    // Set type for styling
    container.setAttribute("data-type", info.type);
    
    // Toggle compact mode
    if (options.compact) {
      container.classList.add("compact");
    } else {
      container.classList.remove("compact");
    }

    // Set icon
    const iconEl = container.querySelector("[data-icon]");
    if (iconEl && info.icon && ERROR_ICONS[info.icon]) {
      iconEl.innerHTML = `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${ERROR_ICONS[info.icon]}</svg>`;
    } else if (iconEl) {
      iconEl.innerHTML = `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${ERROR_ICONS["alert-circle"]}</svg>`;
    }

    // Set content
    const titleEl = container.querySelector("[data-title]");
    const messageEl = container.querySelector("[data-message]");
    const hintEl = container.querySelector("[data-hint]");
    
    if (titleEl) titleEl.textContent = info.title;
    if (messageEl) messageEl.textContent = info.message;
    if (hintEl) hintEl.textContent = info.hint || "";

    // Set actions
    const actionsEl = container.querySelector("[data-actions]");
    if (actionsEl) {
      actionsEl.innerHTML = "";
      
      if (info.action) {
        const btn = document.createElement("button");
        btn.className = "error-action-btn error-action-primary";
        btn.textContent = info.action.label;
        btn.type = "button";
        btn.dataset.action = info.action.handler;
        actionsEl.appendChild(btn);
      }

      // Add dismiss button for non-critical errors
      if (info.type !== "auth" && info.type !== "quota_exceeded") {
        const dismissBtn = document.createElement("button");
        dismissBtn.className = "error-action-btn error-action-secondary";
        dismissBtn.textContent = "Dismiss";
        dismissBtn.type = "button";
        dismissBtn.dataset.action = "dismiss";
        actionsEl.appendChild(dismissBtn);
      }
    }

    // Show the error
    container.style.display = "block";
  }

  /**
   * Hide an enhanced error
   */
  export function hideEnhancedError(elementId: string): void {
    const container = document.getElementById(elementId);
    if (!container) return;
    container.style.display = "none";
    callbacks.delete(elementId);
  }

  // Global click handler for error actions
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    if (!target.matches("[data-action]")) return;

    const action = target.dataset.action;
    const errorContainer = target.closest(".enhanced-error");
    if (!errorContainer) return;

    const elementId = errorContainer.id;
    const opts = callbacks.get(elementId) || {};

    switch (action) {
      case "retry":
        if (opts.onRetry) {
          hideEnhancedError(elementId);
          opts.onRetry();
        }
        break;
      case "refresh":
        if (opts.onRefresh) {
          opts.onRefresh();
        } else {
          window.location.reload();
        }
        break;
      case "settings":
        if (opts.onSettings) {
          opts.onSettings();
        } else {
          window.location.href = "/app/settings";
        }
        break;
      case "upgrade":
        if (opts.onUpgrade) {
          opts.onUpgrade();
        } else {
          window.location.href = "/#pricing";
        }
        break;
      case "dismiss":
        hideEnhancedError(elementId);
        break;
      case "login":
        window.location.href = "/app/settings";
        break;
      case "contact":
        window.location.href = "mailto:support@sec-scanner.pro";
        break;
    }
  });

  // Export to window for inline scripts
  (window as unknown as Record<string, unknown>).showEnhancedError = showEnhancedError;
  (window as unknown as Record<string, unknown>).hideEnhancedError = hideEnhancedError;
</script>
