---
// TimelineChart component - displays security score trends over time using D3.js
---

<div id="timelineContainer" class="timeline-chart">
  <div id="timelineError" style="display: none; margin-top: var(--space-3);">
    <div class="muted" style="font-size: 13px;">No historical data available</div>
  </div>
  <div id="timelineContent" style="display: none;">
    <h3 class="h3" style="margin-bottom: var(--space-2);">Security Score Timeline</h3>
    <div id="timelineChart" style="width: 100%; min-height: 300px;"></div>
  </div>
  <div id="timelineLoading" style="display: none;">
    <div class="skeleton skeleton-text" style="width: 60%; margin-bottom: var(--space-2);"></div>
    <div class="skeleton" style="height: 300px; border-radius: 8px; margin-top: var(--space-3);"></div>
  </div>
</div>

<script>
  import * as d3 from "d3";

  export function renderTimeline(containerId, data) {
    const container = document.getElementById(containerId || "timelineContainer");
    const content = document.getElementById("timelineContent");
    const error = document.getElementById("timelineError");
    const loading = document.getElementById("timelineLoading");
    const chartEl = document.getElementById("timelineChart");

    if (!data || !data.items || data.items.length === 0) {
      if (content) content.style.display = "none";
      if (loading) loading.style.display = "none";
      if (error) error.style.display = "block";
      return;
    }

    if (error) error.style.display = "none";
    if (loading) loading.style.display = "none";
    if (content) content.style.display = "block";

    if (!chartEl) return;

    // Clear previous chart
    chartEl.innerHTML = "";

    const margin = { top: 20, right: 30, bottom: 40, left: 50 };
    const width = chartEl.clientWidth - margin.left - margin.right;
    const height = 300 - margin.top - margin.bottom;

    // Parse dates and prepare data
    const items = data.items
      .map((d) => ({
        date: new Date(d.completed_at),
        score: d.overall_score,
        risk_level: d.risk_level || "unknown",
        id: d.id,
      }))
      .sort((a, b) => a.date - b.date); // Sort chronologically

    if (items.length === 0) {
      chartEl.innerHTML = '<div class="muted" style="text-align: center; padding: 40px;">No data points</div>';
      return;
    }

    // Create SVG
    const svg = d3
      .select(chartEl)
      .append("svg")
      .attr("width", width + margin.left + margin.right)
      .attr("height", height + margin.top + margin.bottom);

    const g = svg.append("g").attr("transform", `translate(${margin.left},${margin.top})`);

    // Scales
    const xScale = d3
      .scaleTime()
      .domain(d3.extent(items, (d) => d.date))
      .range([0, width]);

    const yScale = d3
      .scaleLinear()
      .domain([0, 100])
      .nice()
      .range([height, 0]);

    // Line generator
    const line = d3
      .line()
      .x((d) => xScale(d.date))
      .y((d) => yScale(d.score))
      .curve(d3.curveMonotoneX);

    // Color scale for risk levels
    const colorScale = (risk) => {
      if (!risk || risk === "unknown") return "var(--accent)";
      const riskLower = risk.toLowerCase();
      if (riskLower.includes("critical") || riskLower.includes("high")) return "var(--error)";
      if (riskLower.includes("medium") || riskLower.includes("moderate")) return "var(--warning)";
      return "var(--success)";
    };

    // Add grid lines
    g.append("g")
      .attr("class", "grid")
      .attr("transform", `translate(0,${height})`)
      .call(
        d3
          .axisBottom(xScale)
          .tickSize(-height)
          .tickFormat("")
      )
      .style("stroke-dasharray", "3,3")
      .style("opacity", 0.2);

    g.append("g")
      .attr("class", "grid")
      .call(
        d3
          .axisLeft(yScale)
          .tickSize(-width)
          .tickFormat("")
      )
      .style("stroke-dasharray", "3,3")
      .style("opacity", 0.2);

    // Add area under line
    const area = d3
      .area()
      .x((d) => xScale(d.date))
      .y0(height)
      .y1((d) => yScale(d.score))
      .curve(d3.curveMonotoneX);

    g.append("path")
      .datum(items)
      .attr("fill", "var(--accent)")
      .attr("fill-opacity", 0.1)
      .attr("d", area);

    // Add line
    g.append("path")
      .datum(items)
      .attr("fill", "none")
      .attr("stroke", "var(--accent)")
      .attr("stroke-width", 2)
      .attr("d", line);

    // Add dots
    g.selectAll(".dot")
      .data(items)
      .enter()
      .append("circle")
      .attr("class", "dot")
      .attr("cx", (d) => xScale(d.date))
      .attr("cy", (d) => yScale(d.score))
      .attr("r", 4)
      .attr("fill", (d) => colorScale(d.risk_level))
      .attr("stroke", "var(--bg)")
      .attr("stroke-width", 2)
      .on("mouseover", function (event, d) {
        // Show tooltip
        const tooltip = d3.select("body").append("div").attr("class", "tooltip").style("opacity", 0);

        tooltip
          .html(
            `<div style="padding: 8px; background: var(--panel); border-radius: 6px; font-size: 12px;">
              <div style="font-weight: 600;">Score: ${d.score.toFixed(1)}</div>
              <div class="muted" style="margin-top: 4px;">${d.date.toLocaleDateString()} ${d.date.toLocaleTimeString()}</div>
              <div class="muted" style="margin-top: 2px;">Risk: ${d.risk_level || "unknown"}</div>
            </div>`
          )
          .style("position", "absolute")
          .style("pointer-events", "none")
          .style("left", event.pageX + 10 + "px")
          .style("top", event.pageY - 10 + "px")
          .style("opacity", 1)
          .style("z-index", 1000);

        d3.select(this).attr("r", 6);
      })
      .on("mouseout", function () {
        d3.select("body").selectAll(".tooltip").remove();
        d3.select(this).attr("r", 4);
      });

    // Add axes
    g.append("g")
      .attr("transform", `translate(0,${height})`)
      .call(d3.axisBottom(xScale).tickFormat(d3.timeFormat("%Y-%m-%d")))
      .selectAll("text")
      .style("font-size", "11px")
      .style("fill", "var(--text-muted)");

    g.append("g")
      .call(d3.axisLeft(yScale).ticks(5))
      .selectAll("text")
      .style("font-size", "11px")
      .style("fill", "var(--text-muted)");

    // Add axis labels
    g.append("text")
      .attr("transform", "rotate(-90)")
      .attr("y", 0 - margin.left)
      .attr("x", 0 - height / 2)
      .attr("dy", "1em")
      .style("text-anchor", "middle")
      .style("font-size", "12px")
      .style("fill", "var(--text-muted)")
      .text("Security Score");

    g.append("text")
      .attr("transform", `translate(${width / 2}, ${height + margin.bottom - 5})`)
      .style("text-anchor", "middle")
      .style("font-size", "12px")
      .style("fill", "var(--text-muted)")
      .text("Date");
  }

  export function showTimelineLoading() {
    const content = document.getElementById("timelineContent");
    const error = document.getElementById("timelineError");
    const loading = document.getElementById("timelineLoading");
    if (content) content.style.display = "none";
    if (error) error.style.display = "none";
    if (loading) loading.style.display = "block";
  }
</script>

<style>
  .timeline-chart {
    width: 100%;
  }
  .timeline-chart svg {
    display: block;
  }
  .timeline-chart .dot {
    cursor: pointer;
    transition: r 0.2s;
  }
</style>
