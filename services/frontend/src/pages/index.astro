---
import Base from "../layouts/Base.astro";
import PricingCard from "../components/PricingCard.astro";

const pricingPlans = [
  {
    code: "free",
    name: "Free",
    price: "$0",
    period: "month",
    description: "Perfect for trying out sec-scanner.pro",
    features: [
      "10 scans per month",
      "Safe mode only",
      "Basic reports (Markdown)",
      "30 days history",
      "Community support",
    ],
    cta: "Get Started",
    ctaHref: "/app/dashboard",
  },
  {
    code: "starter",
    name: "Starter",
    price: "$29",
    period: "month",
    description: "For small teams and startups",
    features: [
      "100 scans per month",
      "All scan modes (safe, normal, full)",
      "All report formats (PDF, JSON, Markdown)",
      "90 days history",
      "CI/CD integrations",
      "Email notifications",
      "API access (1,000 requests/month)",
      "Priority support",
    ],
    cta: "Start Free Trial",
    ctaHref: "/app/dashboard",
    popular: true,
    badge: "Popular",
  },
  {
    code: "professional",
    name: "Professional",
    price: "$99",
    period: "month",
    description: "For growing teams and businesses",
    features: [
      "500 scans per month",
      "All scan modes + advanced checks",
      "Dependency Scanning",
      "Nmap integration",
      "1 year history",
      "All integrations (Slack, Telegram, Webhooks)",
      "API access (10,000 requests/month)",
      "Priority support (email + chat)",
      "Custom webhooks",
    ],
    cta: "Start Free Trial",
    ctaHref: "/app/dashboard",
  },
  {
    code: "enterprise",
    name: "Enterprise",
    price: "Custom",
    period: "",
    description: "For large organizations",
    features: [
      "Unlimited scans",
      "All features + extended capabilities",
      "OWASP ZAP integration",
      "SAST analysis (up to 10 repos)",
      "Dedicated infrastructure (optional)",
      "On-premise deployment (optional)",
      "SLA guarantees",
      "24/7 priority support",
      "Custom integrations",
      "White-label reports",
      "Dedicated account manager",
    ],
    cta: "Contact Sales",
    ctaHref: "mailto:sales@sec-scanner.pro",
  },
];
---
<Base title="sec-scanner.pro" description="Unified security scanning interface">
  <header class="container site-header">
    <nav class="nav">
      <a href="/" class="brand">
        <span class="panel brand-icon" aria-hidden="true">
          <span class="brand-dot"></span>
        </span>
        <span class="brand-name truncate">sec-scanner.pro</span>
      </a>
      <div class="nav-actions">
        <a class="btn" href="/app/dashboard">Dashboard</a>
        <a class="btn btn-primary" href="https://api.sec-scanner.pro/web-check/" target="_blank" rel="noreferrer">
          Web-Check
        </a>
      </div>
    </nav>
  </header>

  <main class="container fade-in main">
    <section class="panel hero">
      <div class="hero-copy">
        <p class="muted" style="margin:0 0 var(--space-2);">
          Unified interface for audits, reports, and operational workflows
        </p>
        <h1 class="h1">
          Enterprise Security Scanner Platform.
          <span class="muted">Fast, safe, and production‑oriented.</span>
        </h1>
        <p class="muted" style="margin: var(--space-4) 0 0;">
          This UI is the new home for product navigation and dashboards. Web-Check remains available under
          <span class="kbd">/web-check/</span> on the API domain.
        </p>
        <div class="cta-row">
          <a class="btn btn-primary" href="/app/dashboard">Open Dashboard</a>
          <a class="btn" href="https://api.sec-scanner.pro/docs" target="_blank" rel="noreferrer">API Docs</a>
        </div>
      </div>
    </section>

    <section class="grid-12">
      <div class="panel col-6 section">
        <h2 class="h2">Design system first</h2>
        <p class="muted" style="margin: var(--space-2) 0 0;">
          First iteration focuses on crisp layout, typography, tokens, and components. 3D / cinematic transitions come next.
        </p>
      </div>
      <div class="panel col-6 section">
        <h2 class="h2">Secure by default</h2>
        <p class="muted" style="margin: var(--space-2) 0 0;">
          API key support, SSRF guards, strict method limits, and minimal CORS.
        </p>
      </div>
      <div class="panel col-12 section">
        <h2 class="h2">Next</h2>
        <p class="muted" style="margin: var(--space-2) 0 0;">
          Add a proper dashboard: audit queue status, trends, risk distribution, and tenant-scoped access.
        </p>
      </div>
    </section>
  </main>
</Base>

<style>
  .pricing-section {
    margin: var(--space-7) 0;
    padding: var(--space-7) 0;
  }

  .pricing-header {
    text-align: center;
    margin-bottom: var(--space-7);
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-4);
    max-width: 1200px;
    margin: 0 auto;
  }

  @media (min-width: 768px) {
    .pricing-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .pricing-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
