    }
    .detail-cta.cta-enterprise {
      background: var(--gradient-enterprise);
    }

    /* Success */
    .success-view {
      text-align: center;
      padding: 40px 0;
    }
    .success-icon {
      font-size: 56px;
      margin-bottom: 16px;
    }
    .success-text {
      color: var(--text-dim);
      margin-bottom: 20px;
    }

    /* Loading */
    .loading-view {
