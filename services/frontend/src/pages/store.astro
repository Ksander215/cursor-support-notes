<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1" />
  <meta name="robots" content="noindex" />
  <title>Тарифы | sec-scanner.pro</title>
  <script src="https://telegram.org/js/telegram-web-app.js"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
</head>
<body class="store-body">
  <div class="store-container" id="app">
    <header class="header">
      <button class="back-btn" id="btn-back" hidden>← Назад</button>
      <div class="logo">
        <span class="logo-icon">⚡</span>
        <span>SEC SCANNER</span>
      </div>
      <div class="user-info" id="user-badge" hidden>
        <span id="user-status">Проверка...</span>
      </div>
    </header>

    <main class="main" id="main">
      <div class="promo-banner">
        <div class="promo-icon">🛡️</div>
        <div class="promo-text">
          <span class="promo-badge">API SECURITY</span>
          <span class="promo-desc">Сканер безопасности API</span>
        </div>
      </div>

      <div class="section-title">
        <span class="title-icon">🎯</span>
        Выберите тариф
      </div>

      <div class="plans" id="view-plans">
        <!-- FREE -->
        <div class="plan-card-wrapper">
          <div class="plan-card" onclick="showPlanDetail('free')">
            <div class="plan-glow"></div>
            <div class="plan-content">
              <div class="plan-header">
                <span class="plan-emoji">🆓</span>
                <span class="plan-badge">FREE</span>
              </div>
              <div class="plan-price">
                <span class="price-current">0 ₽</span>
                <span class="price-period">/навсегда</span>
              </div>
              <div class="plan-features">
                <div class="feature-card"><span class="feature-check">✓</span> <span>SSL и TLS</span></div>
                <div class="feature-card"><span class="feature-check">✓</span> <span>HTTP-заголовки</span></div>
                <div class="feature-card disabled"><span class="feature-cross">✗</span> <span>OWASP Top-10</span></div>
                <div class="feature-card disabled"><span class="feature-cross">✗</span> <span>CI/CD</span></div>
                <div class="feature-card disabled"><span class="feature-cross">✗</span> <span>Отчёты</span></div>
                <div class="feature-card disabled"><span class="feature-cross">✗</span> <span>Уведомления</span></div>
              </div>
              <button class="plan-btn btn-free">Начать бесплатно</button>
            </div>
          </div>
        </div>

        <!-- PRO -->
        <div class="plan-card-wrapper">
          <div class="plan-card popular" onclick="showPlanDetail('pro')">
            <div class="plan-glow glow-pro"></div>
            <div class="popular-mark">⭐ ХИТ</div>
            <div class="plan-content">
              <div class="plan-header">
                <span class="plan-emoji">⭐</span>
                <span class="plan-badge badge-pro">PRO</span>
              </div>
              <div class="price-row">
                <span class="price-current">490 ₽</span>
                <span class="price-old">990 ₽</span>
              </div>
              <div class="discount-badge">-50%</div>
              <div class="plan-features">
                <div class="feature-card"><span class="feature-check">✓</span> <span>SSL и TLS</span></div>
                <div class="feature-card"><span class="feature-check">✓</span> <span>HTTP-заголовки</span></div>
                <div class="feature-card"><span class="feature-check">✓</span> <span>OWASP Top-10</span></div>
                <div class="feature-card disabled"><span class="feature-cross">✗</span> <span>CI/CD</span></div>
                <div class="feature-card"><span class="feature-check">✓</span> <span>Отчёты</span></div>
                <div class="feature-card disabled"><span class="feature-cross">✗</span> <span>Уведомления</span></div>
              </div>
              <button class="plan-btn btn-pro">Попробовать 7 дней</button>
            </div>
          </div>
        </div>

        <!-- ENTERPRISE -->
        <div class="plan-card-wrapper">
          <div class="plan-card" onclick="showPlanDetail('enterprise')">
            <div class="plan-glow glow-enterprise"></div>
            <div class="plan-content">
              <div class="plan-header">
                <span class="plan-emoji">🏢</span>
                <span class="plan-badge badge-enterprise">ENTERPRISE</span>
              </div>
              <div class="price-row">
                <span class="price-current">2 490 ₽</span>
                <span class="price-old">4 990 ₽</span>
              </div>
              <div class="discount-badge">-50%</div>
              <div class="plan-features">
                <div class="feature-card"><span class="feature-check">✓</span> <span>SSL и TLS</span></div>
                <div class="feature-card"><span class="feature-check">✓</span> <span>HTTP-заголовки</span></div>
                <div class="feature-card"><span class="feature-check">✓</span> <span>OWASP Top-10</span></div>
                <div class="feature-card"><span class="feature-check">✓</span> <span>CI/CD</span></div>
                <div class="feature-card"><span class="feature-check">✓</span> <span>Отчёты</span></div>
                <div class="feature-card"><span class="feature-check">✓</span> <span>Уведомления</span></div>
              </div>
              <button class="plan-btn btn-enterprise">Связаться с нами</button>
            </div>
          </div>
        </div>
      </div>

      <!-- Plan Detail View -->
      <div class="plan-detail" id="view-detail" hidden>
        <h1 class="title" id="detail-title">Тариф</h1>
        
        <div class="detail-price" id="detail-price">
          <span class="price-amount"></span>
          <span class="price-period"></span>
        </div>
        
        <div class="detail-old-price" id="detail-old-price" hidden>
          <span></span>
        </div>

        <div class="detail-features" id="detail-features"></div>

        <button class="detail-cta" id="detail-cta" onclick="handlePlanAction()">Перейти к оплате</button>
      </div>

      <!-- Success View -->
      <div class="success-view" id="view-success" hidden>
        <div class="success-icon">🎉</div>
        <h1 class="title">Готово!</h1>
        <p class="success-text" id="success-text">Подписка активирована</p>
        <button class="detail-cta" onclick="goToPlans()">К тарифам</button>
      </div>

      <!-- Loading View -->
      <div class="loading-view" id="view-loading" hidden>
        <div class="loading-spinner">⏳</div>
        <p>Подождите...</p>
      </div>
    </main>

    <footer class="footer" id="footer">
      <a href="/terms">Условия</a>
      <span>|</span>
      <a href="/privacy">Политика</a>
      <span>|</span>
      <a href="https://t.me/sec_scanner_support" target="_blank">Поддержка</a>
    </footer>
  </div>

  <script is:inline>
    var PLANS = {
      free: {
        name: "Free",
        price: 0,
        period: "навсегда",
        features: {
          ssl_tls: true,
          headers: true,
          owasp: false,
          cicd: false,
          reports: false,
          alerts: false
        },
        cta: "Начать бесплатно"
      },
      pro: {
        name: "PRO",
        price: 490,
        oldPrice: 990,
        period: "мес",
        features: {
          ssl_tls: true,
          headers: true,
          owasp: true,
          cicd: false,
          reports: true,
          alerts: false
        },
        cta: "Попробовать 7 дней"
      },
      enterprise: {
        name: "Enterprise",
        price: 2490,
        oldPrice: 4990,
        period: "мес",
        features: {
          ssl_tls: true,
          headers: true,
          owasp: true,
          cicd: true,
          reports: true,
          alerts: true
        },
        cta: "Связаться с нами"
      }
    };

    var FEATURES = [
      { id: "ssl_tls", name: "SSL и TLS", icon: "🔒", desc: "Версия протокола, срок действия сертификата, слабые шифры" },
      { id: "headers", name: "HTTP-заголовки", icon: "🛡️", desc: "HSTS, CSP, X-Frame-Options, CORS" },
      { id: "owasp", name: "OWASP Top-10", icon: "🔥", desc: "Автоматическое обнаружение уязвимостей из топ-10 OWASP" },
      { id: "cicd", name: "CI/CD интеграция", icon: "⚙️", desc: "Готовые шаблоны для GitHub, GitLab, Jenkins" },
      { id: "reports", name: "Удобные отчёты", icon: "📊", desc: "PDF, JSON и Markdown с историей сканов" },
      { id: "alerts", name: "Уведомления", icon: "🔔", desc: "Telegram, Slack или email при критических уязвимостях" }
    ];

    var tg = window.Telegram && window.Telegram.WebApp;
    var isTG = !!(tg && tg.initDataUnsafe && tg.initDataUnsafe.user && tg.initData);
    var currentPlan = null;

    var views = {
      plans: document.getElementById("view-plans"),
      detail: document.getElementById("view-detail"),
      success: document.getElementById("view-success"),
      loading: document.getElementById("view-loading")
    };
    var footer = document.getElementById("footer");
    var backBtn = document.getElementById("btn-back");
    var ctaBtn = document.getElementById("detail-cta");

    function showView(name) {
      Object.keys(views).forEach(function(k) { views[k].hidden = true; });
      views[name].hidden = false;
      footer.hidden = name === "success" || name === "loading";
      backBtn.hidden = name === "plans";
    }

    function showPlanDetail(planId) {
      currentPlan = planId;
      var plan = PLANS[planId];
      
      document.getElementById("detail-title").textContent = plan.name;
      document.querySelector("#detail-price .price-amount").textContent = plan.price === 0 ? "Бесплатно" : plan.price + " ₽";
      document.querySelector("#detail-price .price-period").textContent = plan.period ? "/" + plan.period : "";
      
      var oldPriceEl = document.getElementById("detail-old-price");
      if (plan.oldPrice) {
        oldPriceEl.hidden = false;
        oldPriceEl.querySelector("span").textContent = plan.oldPrice + " ₽";
      } else {
        oldPriceEl.hidden = true;
      }
      
      var featuresHtml = "";
      FEATURES.forEach(function(f) {
        var available = plan.features[f.id];
        featuresHtml += '<div class="detail-feature ' + (available ? "" : "disabled") + '">' +
          '<span class="feature-icon">' + f.icon + '</span>' +
          '<div class="feature-info">' +
            '<div class="feature-name">' + f.name + (available ? ' ✓' : ' ✗') + '</div>' +
            '<div class="feature-desc">' + f.desc + '</div>' +
          '</div>' +
        '</div>';
      });
      document.getElementById("detail-features").innerHTML = featuresHtml;
      
      ctaBtn.textContent = plan.price === 0 ? "Начать бесплатно" : "Перейти к оплате · " + plan.price + " ₽";
      ctaBtn.className = plan.price === 0 ? "detail-cta cta-free" : (planId === "pro" ? "detail-cta cta-pro" : "detail-cta cta-enterprise");
      
      showView("detail");
    }

    function goToPlans() {
      currentPlan = null;
      showView("plans");
    }

    function showSuccess(text) {
      document.getElementById("success-text").textContent = text || "Подписка активирована!";
      showView("success");
    }

    function showLoading() {
      showView("loading");
    }

    function handlePlanAction() {
      var plan = PLANS[currentPlan];
      
      if (currentPlan === "free") {
        if (!isTG) {
          showSuccess("Тест: подписка Free активирована!");
          return;
        }
        showLoading();
        fetch("https://api.sec-scanner.pro/api/v1/payments/bot/subscribe", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ plan_code: "free", init_data: tg.initData })
        })
        .then(function(r) { return r.ok ? r.json() : Promise.reject(); })
        .then(function() {
          showSuccess("✅ Подписка Free активирована!");
        })
        .catch(function() {
          showSuccess("⚠️ Подписка активирована (возможно)");
        });
        return;
      }
      
      if (plan.price > 0) {
        var payLink = "https://t.me/sec_scanner_support?start=buy_" + currentPlan;
        if (tg && tg.openLink) {
          tg.openLink(payLink);
        } else {
          window.open(payLink, "_blank");
        }
      }
    }

    backBtn.addEventListener("click", goToPlans);

    if (tg) {
      tg.ready();
      tg.expand();
    }

    if (!isTG) {
      document.getElementById("user-badge").hidden = false;
      document.getElementById("user-status").textContent = "Тестовая версия";
    }

    // Telegram theme integration
    (function() {
      var tg = window.Telegram && window.Telegram.WebApp;
      if (!tg || !tg.themeParams) return;
      var colors = tg.themeParams;
      var root = document.documentElement;
      if (colors.bg_color) root.style.setProperty('--tg-bg', colors.bg_color);
      if (colors.text_color) root.style.setProperty('--tg-text', colors.text_color);
      if (colors.hint_color) root.style.setProperty('--tg-hint', colors.hint_color);
      if (colors.button_color) root.style.setProperty('--tg-button', colors.button_color);
      if (colors.button_text_color) root.style.setProperty('--tg-button-text', colors.button_text_color);
      if (colors.secondary_bg_color) root.style.setProperty('--tg-secondary-bg', colors.secondary_bg_color);
      document.body.style.background = colors.bg_color || '#1c1c1e';
      document.body.style.color = colors.text_color || '#ffffff';
    })();
  </script>

  <style>
    :root {
      --bg-dark: #0F0F1A;
      --bg-card: rgba(255, 255, 255, 0.03);
      --text: #fff;
      --text-dim: #888;
      --text-muted: #555;
      --accent-purple: #9333EA;
      --accent-pink: #EC4899;
      --accent-orange: #F59E0B;
      --accent-blue: #3390ec;
      --accent-green: #10B981;
      --gradient-pro: linear-gradient(135deg, #7C3AED, #A855F7);
      --gradient-premium: linear-gradient(135deg, #F59E0B, #EF4444, #EC4899);
      --gradient-enterprise: linear-gradient(135deg, #3B82F6, #6366F1);
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: var(--bg-dark);
      color: var(--text);
      min-height: 100vh;
      padding-bottom: 80px;
    }
    .store-container {
      max-width: 420px;
      margin: 0 auto;
      padding: 12px;
    }

    /* Header */
    .header {
      display: flex;
      align-items: center;
      padding: 12px 0;
      margin-bottom: 12px;
    }
    .back-btn {
      background: none;
      border: none;
      color: #9333EA;
      font-size: 14px;
      cursor: pointer;
      padding: 0 12px 0 0;
    }
    .logo {
      font-weight: 800;
      font-size: 16px;
      letter-spacing: 0.5px;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .logo-icon {
      font-size: 18px;
      animation: pulse 2s infinite;
    }
    .user-info {
      font-size: 11px;
      color: var(--text-dim);
      background: var(--bg-card);
      padding: 4px 10px;
      border-radius: 12px;
      margin-left: auto;
      border: 1px solid rgba(147, 51, 234, 0.2);
    }

    /* Promo Banner */
    .promo-banner {
      background: rgba(147, 51, 234, 0.12);
      border: 1px solid rgba(147, 51, 234, 0.25);
      border-radius: 16px;
      padding: 14px;
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 20px;
    }
    .promo-icon {
      width: 44px;
      height: 44px;
      background: var(--gradient-pro);
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 22px;
    }
    .promo-text {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }
    .promo-badge {
      background: var(--gradient-pro);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      font-weight: 700;
      font-size: 12px;
    }
    .promo-desc {
      color: var(--text-dim);
      font-size: 12px;
    }

    /* Section Title */
    .section-title {
      font-size: 18px;
      font-weight: 700;
      margin-bottom: 16px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .title-icon {
      font-size: 18px;
    }

    /* Plans */
    .plans {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    .plan-card-wrapper {
      position: relative;
    }
    .plan-card {
      position: relative;
      background: var(--bg-card);
      border-radius: 20px;
      overflow: hidden;
      cursor: pointer;
      transition: transform 0.2s ease;
    }
    .plan-card:active {
      transform: scale(0.98);
    }
    .plan-card:hover .plan-glow {
      opacity: 1;
    }

    /* Gradient Border via ::before */
    .plan-card::before {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: 20px;
      padding: 1.5px;
      background: var(--gradient-pro);
      -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
      -webkit-mask-composite: xor;
      mask-composite: exclude;
      pointer-events: none;
    }
    .plan-card.popular::before {
      background: var(--gradient-pro);
    }
    .plan-card:nth-child(3)::before {
      background: var(--gradient-enterprise);
    }

    /* Glow Effect */
    .plan-glow {
      position: absolute;
      top: -50%;
      left: -50%;
      width: 200%;
      height: 200%;
      background: radial-gradient(circle at 50% 50%, rgba(147, 51, 234, 0.08), transparent 60%);
      opacity: 0.6;
      transition: opacity 0.3s;
      pointer-events: none;
    }
    .plan-card.popular .plan-glow {
      background: radial-gradient(circle at 50% 50%, rgba(124, 58, 237, 0.12), transparent 50%);
    }
    .plan-card:nth-child(3) .plan-glow {
      background: radial-gradient(circle at 50% 50%, rgba(59, 130, 246, 0.1), transparent 50%);
    }

    /* Content */
    .plan-content {
      position: relative;
      padding: 20px;
      z-index: 1;
    }
    .plan-header {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 12px;
    }
    .plan-emoji {
      font-size: 28px;
    }
    .plan-badge {
      font-size: 13px;
      font-weight: 700;
      color: var(--text-dim);
      letter-spacing: 0.5px;
    }
    .badge-pro {
      background: var(--gradient-pro);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .badge-enterprise {
      background: var(--gradient-enterprise);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    /* Popular Mark */
    .popular-mark {
      position: absolute;
      top: 12px;
      right: 12px;
      background: var(--gradient-pro);
      color: #fff;
      font-size: 10px;
      font-weight: 700;
      padding: 4px 10px;
      border-radius: 8px;
    }

    /* Price */
    .plan-price {
      margin-bottom: 4px;
    }
    .price-row {
      display: flex;
      align-items: baseline;
      gap: 10px;
    }
    .price-current {
      font-size: 28px;
      font-weight: 800;
      line-height: 1;
    }
    .price-old {
      font-size: 14px;
      color: var(--text-muted);
      text-decoration: line-through;
    }
    .price-period {
      font-size: 14px;
      font-weight: 400;
      color: var(--text-dim);
    }
    .discount-badge {
      position: absolute;
      top: 12px;
      right: 12px;
      background: rgba(239, 68, 68, 0.2);
      color: #EF4444;
      font-size: 11px;
      font-weight: 700;
      padding: 4px 8px;
      border-radius: 8px;
    }
    .plan-card:nth-child(3) .discount-badge {
      background: rgba(59, 130, 246, 0.2);
      color: #3B82F6;
    }

    /* Features */
    .plan-features {
      margin: 16px 0;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .feature-card {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 8px 10px;
      background: rgba(255, 255, 255, 0.04);
      border-radius: 10px;
      font-size: 13px;
      color: var(--text-dim);
    }
    .feature-card.disabled {
      opacity: 0.35;
    }
    .feature-check {
      color: var(--accent-green);
      font-weight: 700;
      font-size: 12px;
    }
    .feature-cross {
      color: var(--text-muted);
      font-size: 12px;
    }

    /* Buttons */
    .plan-btn {
      width: 100%;
      padding: 14px;
      border-radius: 14px;
      font-size: 15px;
      font-weight: 700;
      border: none;
      cursor: pointer;
      transition: all 0.2s ease;
      margin-top: 8px;
    }
    .plan-btn:active {
      transform: scale(0.98);
    }
    .btn-free {
      background: var(--accent-green);
      color: #fff;
    }
    .btn-pro {
      background: var(--gradient-pro);
      color: #fff;
      box-shadow: 0 4px 20px rgba(147, 51, 234, 0.35);
    }
    .btn-pro:hover {
      filter: brightness(1.1);
      transform: scale(1.02);
    }
    .btn-enterprise {
      background: var(--gradient-enterprise);
      color: #fff;
      box-shadow: 0 4px 20px rgba(59, 130, 246, 0.3);
    }
    .btn-enterprise:hover {
      filter: brightness(1.1);
      transform: scale(1.02);
    }

    /* Detail View */
    .plan-detail {
      padding: 0;
    }
    .detail-price {
      font-size: 32px;
      font-weight: 700;
      margin-bottom: 4px;
    }
    .detail-price .price-period {
      font-size: 16px;
      font-weight: 400;
      color: var(--text-dim);
    }
    .detail-old-price {
      font-size: 16px;
      color: var(--text-muted);
      text-decoration: line-through;
      margin-bottom: 20px;
    }
    .detail-features {
      margin: 20px 0;
    }
    .detail-feature {
      display: flex;
