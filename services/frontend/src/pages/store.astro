      .plan-btn { padding: 12px; font-size: 14px; }
      .header { padding: 10px 0; }
      .section-title { font-size: 16px; }
      .promo-banner { padding: 12px; }
      .feature { font-size: 12px; }
    }

    @media (max-height: 600px) {
