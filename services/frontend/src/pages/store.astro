      border-radius: 12px;
      margin-bottom: 8px;
      border: 1px solid rgba(255, 255, 255, 0.05);
    }
    .detail-feature.disabled {
      opacity: 0.4;
    }
    .feature-icon {
      font-size: 20px;
    }
    .feature-info {
      flex: 1;
    }
    .feature-name {
      font-weight: 600;
      margin-bottom: 2px;
    }
    .feature-desc {
      font-size: 12px;
      color: var(--text-dim);
    }
    .detail-cta {
      width: 100%;
      padding: 16px;
      font-size: 16px;
      font-weight: 700;
      border: none;
      border-radius: 14px;
      cursor: pointer;
      background: var(--gradient-pro);
