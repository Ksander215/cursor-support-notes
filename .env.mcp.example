# MCP Environment Variables (EXAMPLE)
# ВАЖНО: Скопируйте этот файл как .env.mcp и замените значения на реальные!
# Файл .env.mcp добавлен в .gitignore для защиты ваших токенов

# GitHub Personal Access Token
# Получите токен: https://github.com/settings/tokens
# Права: repo, workflow
# Формат: ghp_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
GITHUB_TOKEN=your_github_token_here

# PostgreSQL Connection String
# Для dev: sqlite:///data/sec_scanner.db
# Для prod: postgresql://user:password@host:5432/sec_scanner
POSTGRES_CONNECTION_STRING=postgresql://sec_scanner:sec_scanner@localhost:5432/sec_scanner

# GitLab Personal Access Token (опционально)
# Получите токен: https://gitlab.com/-/user_settings/personal_access_tokens
# Права: api, read_repository, write_repository
# Формат: glpat-XXXXXXXXXXXXXXXXXXXX
GITLAB_TOKEN=your_gitlab_token_here

# Slack Bot Token (опционально)
# Получите токен: https://api.slack.com/apps
# Формат: xoxb-XXXXXXXXXXXX-XXXXXXXXXXXX-XXXXXXXXXXXXXXXXXXXXXXXX
SLACK_BOT_TOKEN=your_slack_bot_token_here

# Telegram Bot (альтернатива Slack)
# Создайте бота через @BotFather в Telegram
# Формат токена: 1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
# Формат Chat ID: 123456789
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Redis URL (опционально)
REDIS_URL=redis://localhost:6379/0
