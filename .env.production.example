POSTGRES_PASSWORD=CHANGE_ME_STRONG

# Domains (for nginx config scripts)
ROOT_DOMAIN=sec-scanner.pro
API_DOMAIN=api.sec-scanner.pro

# UI (root domain) -> API base URL
# If omitted, UI defaults to https://api.sec-scanner.pro
UI_API_BASE_URL=https://api.sec-scanner.pro

# Let's Encrypt email (required)
LETSENCRYPT_EMAIL=admin@sec-scanner.pro

# --- Security / access control (optional) ---
# If set, API requires X-API-Key / Authorization: Bearer for /api/v1/*
SEC_SCANNER_API_KEY=
# Allow scanning private/loopback/link-local targets (SSRF-sensitive). Default: false
SEC_SCANNER_ALLOW_PRIVATE_TARGETS=false

# --- SaaS mode (REQUIRED for production; DB-backed keys) ---
# If true, API requires a DB-backed API key (api_keys table) for all /api/v1/* endpoints
# CRITICAL: Set to true in production to secure your API
SEC_SCANNER_REQUIRE_API_KEY=true
# Pepper for hashing DB-backed API keys (MUST be set if you use DB-backed keys)
# Generate a strong random value: openssl rand -hex 32
SEC_SCANNER_API_KEY_PEPPER=CHANGE_ME_RANDOM

# --- Payment Providers Configuration ---

# Stripe Configuration (for international payments)
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (create products/prices in Stripe Dashboard)
# Format: price_xxxxx for each plan
STRIPE_PRICE_FREE=
STRIPE_PRICE_STARTER=price_xxxxx
STRIPE_PRICE_PROFESSIONAL=price_xxxxx
STRIPE_PRICE_ENTERPRISE=price_xxxxx

# YooKassa Configuration (for Russian market)
# Get these from https://yookassa.ru/developers/payment-acceptance/getting-started/quick-start
YOOKASSA_SHOP_ID=your_shop_id
YOOKASSA_SECRET_KEY=your_secret_key
YOOKASSA_WEBHOOK_SECRET=your_webhook_secret

# --- Telegram Alerts Configuration (RECOMMENDED for production) ---
# Real-time notifications for errors, warnings, and important events
# Get bot token from @BotFather in Telegram
# Get chat_id from: https://api.telegram.org/bot<YOUR_BOT_TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERTS_ENABLED=false
# Alert level: DEBUG, INFO, WARNING, ERROR, CRITICAL (only send alerts >= this level)
TELEGRAM_ALERT_LEVEL=WARNING
